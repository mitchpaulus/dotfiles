#!/usr/bin/env mshell

# f2c - Convert Fahrenheit to Celsius

"f2c - Convert Fahrenheit to Celsius

USAGE:

    f2c FahrenheitTemp" help!

args len 1 < if "No temperature entered.\n" wle @help wle 1 exit end
args (dup "-h" = swap "--help" = or) any if @help wl 0 exit end

args :0: arg!
@arg toFloat match
    just f : @f 32.0 - 5.0 * 9.0 / str wl,
    # Assume it's an Excel cell reference, so print formula to copy
    none : $"=({@arg} - 32) * 5/9" wl,
end
