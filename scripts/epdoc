#!/usr/bin/env mshell

runtime 'windows' = if
    'C:\' lsDir (isDir) filter (basename str 'EnergyPlus' startsWith) filter sortV dirs!
    @dirs len 0 = if 'No EnergyPlus dirs found' wle 1 exit end
    @dirs :-1: dir!
    @dir toPath `Documentation` / `InputOutputReference.pdf` / pdf!
    ['powershell.exe' '-NoProfile' '-Command' $"Start-Process \"{@pdf}\""]!

else* $WSLENV? *if
    ['fd' '-t' 'f' 'InputOutputReference.pdf' $"/mnt/c/"] * ! lines sortV files!
    @files len 0 > if
        @files :-1: dirname DIR! ['cmd.exe' '/C' 'start' '' [wslpath '-w' @DIR]*!chomp]!
    else
        'No InputOutput reference found' wle 1 exit
    end
else* runtime 'linux' = *if
    ['fd' '-t' 'f' 'InputOutputReference.pdf' $"{$HOME}/.local/opt/"] * ! lines sortV files!
    @files len 0 > if
        ['xdg-open' @files :-1:]!
    else
        'No InputOutput reference found' wle 1 exit
    end
else
    'Not implemented yet.' wle 1 exit
end
