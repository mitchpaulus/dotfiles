#!/usr/bin/env mshell

def printHelp (--)
    [
        "biquadratic_excel"
        ""
        "USAGE:"
        "    biquadratic_excel [--horiz] <START_COL> <START_ROW> <X_CELL> <Y_CELL> [SHEET]"
        ""
        "Dollar signs ($) will be added to the coefficient range by default."
        "Note assumed order of coefficients is:"
        " Constant"
        " x"
        " x^2"
        " y"
        " y^2"
        " x*y"
    ] uw
end

def excelLetterValue (str -- int)
    upper letter!
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ" "" split (@letter =) linearSearchIndex ? 1 +
end

def excelColumnNumber (str -- int)
    upper "" split letters!
    @letters len 0 = if "Excel column cannot be empty." wle 1 exit end
    @letters map. excelLetterValue end values!
    (swap 26 * +) 0 @values foldl
end

def excelColumnName (int -- str)
    number!
    @number 1 < if "Excel column number must be positive." wle 1 exit end

    "ABCDEFGHIJKLMNOPQRSTUVWXYZ" "" split alphabet!
    [] letters!
    (
        @number 0 = if break end
        @number 1 - adjusted!
        @alphabet @adjusted 26 mod nth letter!
        @letters @letter append letters!
        @adjusted 26 / number!
    ) loop
    @letters reverse "" join
end

def cellReference (str str int -- str)
    row! column! sheet!
    $"{@sheet}${@column}${@row}"
end

args any. dup "-h" = swap "--help" = or end if
    printHelp
    0 exit
end

args len 0 = if
    printHelp
    0 exit
end

args any. "--horiz" = end horizontal!
args filter. "--horiz" = not end positionals!

@positionals len 4 < @positionals len 5 > or if
    "Expected START_COL START_ROW X_CELL Y_CELL and optional SHEET." wle
    1 exit
end

@positionals :0: upper startColumn!
@positionals :1: toInt ? startRow!
@positionals :2: xCell!
@positionals :3: yCell!

@positionals len 5 = if
    @positionals :4: sheetName!
    $"'{@sheetName}'!" sheet!
else
    "" sheet!
end

@startColumn excelColumnNumber startColumnNumber!

@horizontal if
    6 seq map.
        @startColumnNumber + excelColumnName column!
        @sheet @column @startRow cellReference
    end
else
    6 seq map.
        @startRow + row!
        @sheet @startColumn @row cellReference
    end
end coefficients!

@coefficients :0: constant!
@coefficients :1: x!
@coefficients :2: xx!
@coefficients :3: y!
@coefficients :4: yy!
@coefficients :5: xy!

$"={@constant} + ({@x} * {@xCell}) + ({@xx} * {@xCell} * {@xCell}) + ({@y} * {@yCell}) + ({@yy} * {@yCell} * {@yCell}) + ({@xy} * {@xCell} * {@yCell})" w
