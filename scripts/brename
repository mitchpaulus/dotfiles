#!/usr/bin/env mshell

# This script accepts relative filepaths from the standard input,
# opens the default EDITOR to make changes, prints the renames as
# shell commands, and applies them after confirmation.

# No isatty builtin, so shell out per platform.
def isTty (str -- bool)
    fd!
    runtime "windows" = if
        @fd "0" = if
            '[Console]::IsInputRedirected' check!
        else
            '[Console]::IsOutputRedirected' check!
        end
        [powershell '-NoProfile' '-Command' @check] * ! trim "False" =
    else
        [test '-t' @fd]? 0 =
    end
end

def sepCount (str -- int)
    s!
    @s "/" countSubStr @s "\\" countSubStr +
end

$EDITOR? not if
    "No editor set" wle
    1 exit
end
$EDITOR editor!

"1" isTty not if
    "stdout is not a terminal" wle
    1 exit
end

# Read file names from stdin if piped, otherwise list the current directory
"0" isTty if
    files dirs + (basename str) map fileList!
else
    stdin chomp lines fileList!
end

@fileList sortV fileList!

# Put files to temp file and edit
tempDir `brename` / str tmpFile!
@fileList unlines @tmpFile writeFile
@editor wsplit @tmpFile append ;

@tmpFile readFile chomp lines newNames!

@fileList len @newNames len != if
    "Number of files and new names does not match" wle
    1 exit
end

@fileList @newNames (2tuple) zip pairs!

# Check that the files are being renamed, not moved
@pairs each.
    dup :0: sepCount swap :1: sepCount != if
        "Files are being moved, not renamed" wle
        1 exit
    end
end

@pairs each.
    dup :0: old! :1: new!
    @old @new = if
        $"# {@old} is not being renamed" wl
    else
        $"{@old} -> {@new}" wl
    end
end

"Do you want to run this? (y/n) " prompt trim "y" = if
    @pairs each.
        dup :0: old! :1: new!
        @old @new != if
            $"Renaming {@old} to {@new}" wl
            @new toPath dirname dir!
            @dir str "." != if
                @dir str mkdirp
            end
            @old @new mv
        end
    end
end
