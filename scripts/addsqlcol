#!/usr/bin/env mshell

# CLI helper for generating an ALTER TABLE statement that adds a column.

def unquoteColumn (str -- str)
    "^'(.*)'$" '$1' reReplace
end

def sqlServerType (-- str)
    "Enter data type:" wl
    "1. int" wl
    "2. varchar" wl
    "3. datetime" wl
    "4. bit" wl
    "5. float" wl

    "Enter data type: " prompt match
        "1" : "INT",
        "2" :
            "Enter length (0 for max): " prompt length!
            @length "0" = if "MAX" length! end
            $"VARCHAR({@length})",
        "3" : "DATETIME",
        "4" : "BIT",
        "5" : "FLOAT",
        _   : "Invalid data type" wl sqlServerType,
    end
end

def sqliteType (-- str)
    "Enter data type affinity:" wl
    "1. integer" wl
    "2. text" wl
    "3. real" wl
    "4. numeric" wl
    "5. blob" wl

    "Enter data type: " prompt match
        "1" : "INTEGER",
        "2" : "TEXT",
        "3" : "REAL",
        "4" : "NUMERIC",
        "5" : "BLOB",
        _   : "Invalid data type" wl sqliteType,
    end
end

def sqliteNullability (-- str)
    "Is this column nullable? (y/n)" wl
    "Enter choice (y): " prompt lower match
        "n"  : " NOT NULL",
        "y" "" : " NULL",
        _    : "Invalid choice (y/n)" wl sqliteNullability,
    end
end

def sqlServer (--)
    "SQL Server" wl
    "Enter table name: " prompt table!
    "Enter column name: " prompt unquoteColumn col!
    sqlServerType dataType!
    $"ALTER TABLE {@table} ADD {@col} {@dataType};" wl
end

def sqlite (--)
    "Sqlite" wl
    "Enter table name: " prompt table!
    "Enter column name: " prompt unquoteColumn col!
    sqliteType dataType!
    sqliteNullability nullability!
    $"ALTER TABLE {@table} ADD COLUMN {@col} {@dataType}{@nullability};" wl
end

def main (--)
    "Is this SQL Server or Sqlite?" wl
    "1. SQL Server" wl
    "2. Sqlite" wl
    "3. Exit" wl

    "Enter choice: " prompt match
        "1" : sqlServer,
        "2" : sqlite,
        "3" : 0 exit,
        _   : "Invalid choice" wl main,
    end
end

main
