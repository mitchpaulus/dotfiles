#!/usr/bin/env mshell
args len 1 != ("Usage: upload-ref <file>" wle 1 exit) iff

$REFERENCESKEYID? not if "$REFERENCESKEYID env var not set" wle 1 exit end
$REFERENCESKEY?   not if "$REFERENCESKEY env var not set" wle 1 exit end
$REF_BUCKET?      not if "$REF_BUCKET env var not set" wle 1 exit end

$REFERENCESKEYID $B2_APPLICATION_KEY_ID!
$REFERENCESKEY $B2_APPLICATION_KEY!

['sha256sum' $1]*! chomp 0:64 sha256sum!
['b2-linux' 'upload-file' $REF_BUCKET $1 @sha256sum]!
