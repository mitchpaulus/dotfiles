#!/usr/bin/env mshell

# args len 1 < ("Usage: docx2pdf <docx-file> [pdf-file]" wl 0 exit) iff

none pdfFile!
args match
    []: "Usage: docx2pdf <docx-file> [pdf-file]" wl 0 exit,
    [arg ...rest] : @arg match
        '-h' '--help' : "Usage: docx2pdf <docx-file> [pdf-file]" wl 0 exit,
        _ : @arg docxFile!
            @rest match
                [] :,
                [pdfFileStr] : @pdfFileStr just pdfFile!,
                _ : "Usage: docx2pdf <docx-file> [pdf-file]" wl 0 exit
            end
    end
end

".docx" tempFileExt tmpfile!
$"Tmp File {@tmpfile}" wle
@docxFile @tmpfile cp
$"Converting '{@tmpfile}' to PDF..." wle

runtime "windows" != if
    `WINWORD.EXE` word!
    [wslpath -w -a @tmpfile]*! trim toPath input-docx!
else
    `C:\Program Files\Microsoft Office\root\Office16\WINWORD.EXE` word!
    @tmpfile input-docx!
end

[@word @input-docx '/mMpPrintToPDF']!
"Successfully printed to PDF." wle

def move-result-file (str Maybe[str] --)
    docxFile!, pdfFile!

    @pdfFile match
            just file : @file,
            _ : @docxFile stem str ".pdf" +
    end toPath
    outPath!

    runtime "windows" = if
        $TMP toPath `docx.pdf` /
        @outPath
        mv
    else
        [winenv TMP]*! chomp windowsTmpPath!
        [wslpath -u @windowsTmpPath]*! chomp unixTempPath!

        # args len 1 > if @pdfFile else @docxFile stem str ".pdf" + end toPath path!

        ['mv' @unixTempPath "/docx.pdf" + @outPath];
    end
end

# If a second arg, it is the name of the output file.
@docxFile @pdfFile move-result-file

# Clean up temp file
@tmpfile rmf

# OLD
# Get from https://github.com/cognidox/OfficeToPDF
# OfficeToPDF.exe '/bookmarks' '/readonly' '/noquit' '/working_dir' 'C:\Users\mpaulus\tmp' "$@"
