#!/usr/bin/env mshell

args any. dup "-h" = swap "--help" = or end if
    [
        "Usage: "
        "  biquadratic-deriv <1 | 2> X Y [file]"
        "  biquadratic-deriv  -h"
        ""
        "  <1 | 2> derivative for first or second parameter"
        "  X: column number"
        "  Y: row number"
        "  file: file to read from (default: stdin)"
    ] uw
    0 exit
end


args len 3 < if
    "3 arguments required: X Y [file]" wl
    1 exit
end

args :0: parameter!
args :1: x!
args :2: y!

args len 3 = if
    stdin lines
else
    args 3: map. readFile lines end concat
end
["" "" "" "" "" ""] + 6 take # Ensure we have at least 6 lines.
map. wsplit fields! @fields len 0 = if "" else @fields :0: end end coefficients!

@coefficients :1: b1!
@coefficients :2: b2!
@coefficients :3: b3!
@coefficients :4: b4!
@coefficients :5: b5!

@parameter match
    "1" : $"{@b1} + (2 * {@b2} * {@x}) + ({@b5} * {@y})" wl,
    "2" : $"{@b3} + (2 * {@b4} * {@y}) + ({@b5} * {@x})" wl,
    _   : "Invalid parameter. Expected 1 or 2." wl 1 exit,
end
