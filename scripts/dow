#!/usr/bin/env mshell

args any. dup "-h" = swap "--help" = or end if
    "dow - determine day of the week\n\ndow year month day\n\nyear  = 4 digit year\nmonth = 1-12\nday   = 1-31" wl
    0 exit
end

args len 3 = not if
    args len received!
    $"dow expects 3 arguments, received {@received}" wl
    1 exit
end

args :0: year!
args :1: month!
args :2: day!
$"{@year}-{@month}-{@day}" toDt ? date!

@date dow dayNumber!
@date "Monday" dateFmt dayName!
$"{@dayNumber} {@dayName}" wl
