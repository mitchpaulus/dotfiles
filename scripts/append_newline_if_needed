#!/usr/bin/env mshell

args len 1 = not if
    "Usage: append_newline_if_needed <file>" wl
    1 exit
end

$1 filename!
@filename readFile contents!

@contents len 0 = if
    "Error: [Errno 22] Invalid argument" wle
    0 exit
end

@contents "\n" endsWith if
    0 exit
end

# Match the newline style used by the first line.
@contents "\n" in @contents "\n" split :0: "\r" endsWith and if
    "\r\n" newline!
    '\r\n' newlineName!
else
    "\n" newline!
    '\n' newlineName!
end

@newline @filename appendFile
$"Appended newline '{@newlineName}' to {@filename}" wle
