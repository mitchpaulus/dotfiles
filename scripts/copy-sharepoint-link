#!/usr/bin/env mshell
$1 filepath!
$2 lf-id!

['lf' '-remote' $"send {@lf-id} echomsg Getting SharePoint link..."];

['uv' 'run' $REPOS toPath `ms-graph` `create_link.py` / / @filepath] * ? not if
    ['lf' '-remote' $"send {@lf-id} echomsg Failed to copy link"]; "Exiting" wl 1 exit
end

chomp clip
['lf' '-remote' $"send {@lf-id} echomsg Copied SharePoint link to clipboard"] ;
