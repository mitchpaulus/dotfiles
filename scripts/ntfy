#!/usr/bin/env mshell
args match
    [] : 'No args provided' wl 1 exit,
    ['-h'] : 'USAGE: ntfy message' wl 0 exit,
    ['--help'] : 'USAGE: ntfy message' wl 0 exit,
    ['in' delay ...messageItems] : { 'url': $NTFY_URL, 'headers': { 'In': @delay, 'p': 4 }, 'body': @messageItems ' ' join } httpPost? :body? utf8Str we,
    [...messageItems] : { 'url': $NTFY_URL, 'headers': { 'p': 4 }, 'body': @messageItems ' ' join } httpPost? :body? utf8Str we
end
