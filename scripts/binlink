#!/usr/bin/env mshell

args (a! @a "-h" = @a "--help" = or) any if
'binlink

USAGE:
    binlink <executable file>

binlink creates a relative symlink to the executable file in ~/.local/bin or $USERPROFILE/bin under the same name.
' w 0 exit
end

args len 1 != ($"1 argument expected, {args len} received." wle 1 exit) iff

$LOCALBIN? if
    $LOCALBIN isDir if $LOCALBIN else "$LOCALBIN not a directory?" wle 1 exit end
else
    runtime "windows" = if $"{$USERPROFILE}\\bin" else $"{$HOME}/.local/bin" end
end
dir!

@dir mkdirp
$1 basename filename!

@dir toPath @filename toPath / fullBinPath!
$"Checking {@fullBinPath}.." wle
@fullBinPath fileExists if
    $"Link already exists. Do you want to remove it? [y/N] " prompt
    trim match
        "y" "Y"    : $"{@dir}/{@filename}" rm,
        "n" "N" "" :  0 exit,
        _          : $"Invalid answer. Exiting." wle 1 exit
    end
end

runtime "windows" = if
    $1  @fullBinPath hardLink
else
    ['ln' '-s' $1 absPath @fullBinPath]!
    # ['chmod''+x' @fullBinPath]!
end
