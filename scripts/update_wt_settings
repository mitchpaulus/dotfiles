def updateFile (path --)
    file!
    @file isFile not if $"Could not read settings file: {@file}" wle return end

    @file parseJson tryAs Settings match
        just s : @s,
        none :
            $"Settings file does not match the 1.24 schema: {@file}" wle
            return,
    end settings!
    "Settings file loaded" wl

    @settings "copyOnSelect" false setd
    @settings "copyFormatting" false setd
    @settings "trimBlockSelection" true setd
    @settings "trimPaste" true setd

    # Wipe the existing actions and keybindings, put my own
    @settings "actions" myActions setd
    @settings "keybindings" myKeybindings setd

    # Merge my color schemes into the existing ones by 'name'.
    # Existing schemes keep their position, mine replace them in place, new ones are appended.
    @settings :schemes? existing!
    @existing (:name "" maybe) (id) listToDict existingByName!

    mySchemes mine!
    @mine (:name "" maybe) (id) listToDict myByName!

    @existing map.
        scheme!
        @myByName @scheme :name "" maybe get @scheme maybe
    end
    @mine filter. scheme! @existingByName @scheme :name "" maybe in not end
    + schemes!
    @settings "schemes" @schemes setd

    @settings toJson @file writeFile
end

@settingsFiles (updateFile) each
