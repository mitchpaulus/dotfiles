#!/usr/bin/env msh
# Overwrite my preferred Windows Terminal settings (selection, keybindings, color schemes)
# into the stable and preview settings.json files.
# Works natively on Windows or from WSL.

runtime "windows" = if
    $LOCALAPPDATA toPath
else
    `/mnt/c/Users/mpaulus/AppData/Local`
end localAppData!

[
    `Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json`
    `Packages/Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe/LocalState/settings.json`
] map. @localAppData swap / end settingsFiles!

# Types for the parts of the Windows Terminal 1.24 settings schema this script touches:
# https://raw.githubusercontent.com/microsoft/terminal/release-1.24/doc/cascadia/profiles.schema.json
# Everything else passes through as Json.

type Scheme = {
    name?: str,
    background?: str,
    foreground?: str,
    cursorColor?: str,
    selectionBackground?: str,
    black?: str,
    red?: str,
    green?: str,
    yellow?: str,
    blue?: str,
    purple?: str,
    cyan?: str,
    white?: str,
    brightBlack?: str,
    brightRed?: str,
    brightGreen?: str,
    brightYellow?: str,
    brightBlue?: str,
    brightPurple?: str,
    brightCyan?: str,
    brightWhite?: str
}

type NewTabAction = {action: str, commandline?: str}
type Command = {command?: str | NewTabAction | null, id?: str}
type Keybinding = {keys: str | [str], id?: str | null}

type Settings = {
    schemes: [Scheme],
    actions?: [Command],
    keybindings?: [Keybinding],
    copyOnSelect?: bool,
    copyFormatting?: bool | [str] | str,
    trimBlockSelection?: bool,
    trimPaste?: bool,
    *: Json
}

def myActions ( -- new [Command])
[
    { "command": { "action": "newTab", "commandline": "msh.exe" }, "id": "User.newTab.Msh" }
]
end

# Bound to my actions above or the built-in ones from Terminal's defaults.json; a null id unbinds the keys.
def myKeybindings ( -- new [Keybinding])
[
    { "keys": "ctrl+shift+w", "id": null }
    { "keys": "alt+down", "id": null }
    { "keys": "alt+left", "id": null }
    { "keys": "alt+right", "id": null }
    { "keys": "alt+up", "id": null }
    { "keys": "alt+enter", "id": "Terminal.OpenNewTab" }
    { "keys": "alt+shift+enter", "id": "User.newTab.Msh" }
    { "keys": "alt+;", "id": "Terminal.DuplicatePaneAuto" }
    { "keys": "alt+-", "id": "Terminal.DuplicatePaneDown" }
    { "keys": "alt+j", "id": "Terminal.MoveFocusDown" }
    { "keys": "alt+h", "id": "Terminal.MoveFocusLeft" }
    { "keys": "alt+l", "id": "Terminal.MoveFocusRight" }
    { "keys": "alt+k", "id": "Terminal.MoveFocusUp" }
    { "keys": "ctrl+alt+left", "id": "Terminal.MoveFocusPrevious" }
    { "keys": "alt+n", "id": "Terminal.NextTab" }
    { "keys": "alt+p", "id": "Terminal.PrevTab" }
    # { "keys": "alt+o", "id": "Terminal.ClosePane" }
]
end

