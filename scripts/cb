#!/usr/bin/env mshell

args len 0 > if
'cb - Put clipboard contents to standard output

USAGE: cb' wl
0 exit
end

"windows" runtime =  if
     ['powershell.exe' 'Get-Clipboard'] * !
      "\r" "" findReplace
      # '\n$' '' reReplace
      w
else* $WAYLAND_DISPLAY? *if
    [wl-paste]!
else
    ['xclip' '-o' '-selection' 'clipboard']!
end
