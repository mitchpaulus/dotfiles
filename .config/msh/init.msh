type EnvFile = { 'envVars' : [ {'var': str, 'value': str }] }

def parseEnvVarsJson (Result[EnvFile str] -- )
    match
        err s:,
        ok e: @e :envVars match none:, _:> ? (v! @v :var? @v :value? setenv) each end
    end
end

runtime match
    "linux" :
$"{$HOME}/.config/msh/secrets.json" isFile if $"{$HOME}/.config/msh/secrets.json" toPath parseJson tryAs EnvFile parseEnvVarsJson end,
    "windows" :
    $"{$LOCALAPPDATA}\\msh\\secrets.json" isFile if $"{$LOCALAPPDATA}\\msh\\secrets.json" toPath parseJson tryAs EnvFile parseEnvVarsJson end
            # Extra path stuff.
        $"{$LOCALAPPDATA}\\msh\\paths.txt" isFile if
                $"{$LOCALAPPDATA}\\msh\\paths.txt" toPath readFile lines ";" join newPaths!
                $"{$PATH};{@newPaths}" $PATH!
            end
        ,
     _ :
end

def promptGen (PromptInfo -- [PromptItem])
    info!
    pwd pwd!
    [
        ['REPOS' '$REPOS']
        ['JOBSDIR' '🏢' ]
        ['HOME' '~']
        ['USERPROFILE' '~']
    ]
    each. => [env replace] @env getEnv match
        just e : @pwd @e @replace findReplace pwd!,
        _:  end
    end

    [
        $"{@pwd} ({@info :stackDepth?})"
    ]
    @info :lastExitCode? match none:, just code: $"({@code})" append end

    " " join promptText top!

    # Show user@hostname: when in an SSH session.
    $SSH_CONNECTION? if
        # In SSL
        ['USER' 'USERNAME'] (getEnv) findMap 'Unknown User' maybe u!
        [
            152 195 121 setFgColorRgb @u        promptText
            87 188 223  setFgColorRgb "@"       promptText
            229 192 123 setFgColorRgb hostname  promptText
            87 188 223  setFgColorRgb ":"       promptText
        ]
    else [] end
    sshItems!
    @sshItems [
        87 188 223 setFgColorRgb @top promptNewline
        ":: " promptText setFgDefault
    ] extend
end

(promptGen) setPrompt

[
    ['s' 'git status -u']
    ['v' 'nvim']
    ['mk' 'mkdir']
    ['ls' 'eza -l']
    ['gi' 'nvim .gitignore']
    ['a' 'git add']
    ['d' 'git diff -w']
    ['dc' 'git diff -w --cached']
    ['c' 'git commit']
    ['p' 'git push']
    ['u' "'..' cd"]
    ['gu' '[git add -u]? if [git status -u]; end']
    ['ga' '[git add -A]? if [git status -u]; end']
    ['fp' 'git fetch --prune']
]
each. => [abbr expansion] { 'abbr': @abbr abbrWord, 'expansion': @expansion abbrText } abbrAdd end

